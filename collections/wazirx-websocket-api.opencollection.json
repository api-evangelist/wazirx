              "data": [
                {
                  "name": "recvWindow",
                  "value": ""
                },
                {
                  "name": "timestamp",
                  "value": ""
                },
                {
                  "name": "signature",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Create an authentication token for WebSocket private streams. Requires USER_DATA permission."
        }
      ]
    }

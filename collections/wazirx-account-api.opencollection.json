{
  "opencollection": "1.0.0",
  "info": {
    "name": "WazirX REST Account API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Account information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wazirx.com/sapi/v1/account",
            "params": [
              {
                "name": "recvWindow",
                "value": "",
                "type": "query",
                "description": "Request validity window in milliseconds (max 60000)"
              },
              {
                "name": "timestamp",
                "value": "",
                "type": "query",
                "description": "Current timestamp in milliseconds"
              },
              {
                "name": "signature",
                "value": "",
                "type": "query",
                "description": "HMAC SHA256 signature of request parameters"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Get current account information. Requires USER_DATA permission."
        },
        {
          "info": {
            "name": "Fund details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wazirx.com/sapi/v1/funds",
            "params": [
              {
                "name": "recvWindow",
                "value": "",
                "type": "query",
                "description": "Request validity window in milliseconds (max 60000)"
              },
              {
                "name": "timestamp",
                "value": "",
                "type": "query",
                "description": "Current timestamp in milliseconds"
              },
              {
                "name": "signature",
                "value": "",
                "type": "query",
                "description": "HMAC SHA256 signature of request parameters"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Get current fund balances. Requires USER_DATA permission."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "WazirX REST Account Sub-Account API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Sub-Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Sub-account fund transfer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.wazirx.com/sapi/v1/sub_account/fund_transfer",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "currency",
                  "value": ""
                },
                {
                  "name": "amount",
                  "value": ""
                },
                {
                  "name": "fromEmail",
                  "value": ""
                },
                {
                  "name": "toEmail",
                  "value": ""
                },
                {
                  "name": "recvWindow",
                  "value": ""
                },
                {
                  "name": "timestamp",
                  "value": ""
                },
                {
                  "name": "signature",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Transfer funds between accounts. Requires TRADE permission."
        },
        {
          "info": {
            "name": "Sub-account fund transfer history",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wazirx.com/sapi/v1/sub_account/fund_transfer/history",
            "params": [
              {
                "name": "recvWindow",
                "value": "",
                "type": "query",
                "description": "Request validity window in milliseconds (max 60000)"
              },
              {
                "name": "timestamp",
                "value": "",
                "type": "query",
                "description": "Current timestamp in milliseconds"
              },
              {
                "name": "signature",
                "value": "",
                "type": "query",
                "description": "HMAC SHA256 signature of request parameters"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Get sub-account fund transfer history. Requires USER_DATA permission."
        },
        {
          "info": {
            "name": "Sub-account details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wazirx.com/sapi/v1/sub_account/accounts",
            "params": [
              {
                "name": "recvWindow",
                "value": "",
                "type": "query",
                "description": "Request validity window in milliseconds (max 60000)"
              },
              {
                "name": "timestamp",
                "value": "",
                "type": "query",
                "description": "Current timestamp in milliseconds"
              },
              {
                "name": "signature",
                "value": "",
                "type": "query",
                "description": "HMAC SHA256 signature of request parameters"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Get sub-account details including balances. Requires USER_DATA permission."
        }
      ]
    }
  ],
  "bundled": true
}